{
  "name": "peerflix-server",
  "version": "1.0.0",
  "description": "Modern streaming torrent client for Node.js with Vue 3 Web UI",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "peerflix-server": "./dist/server/server/bin.js"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/bin.ts",
    "dev:client": "vite",
    "dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/server/bin.js",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "iconv-lite": "^0.6.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "parse-torrent": "^11.0.16",
    "pump": "^3.0.2",
    "range-parser": "^1.2.1",
    "socket.io": "^4.8.1",
    "torrent-stream": "^1.2.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/pump": "^1.1.3",
    "@types/qrcode": "^1.5.5",
    "@types/range-parser": "^1.2.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "lucide-vue-next": "^0.469.0",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}

# =========================================================================
# FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT POUR PEERFLIX-SERVER
# Copiez ce fichier sous le nom '.env' pour surcharger les valeurs par défaut
# =========================================================================

# 1. RÉSEAU & PORT D'ÉCOUTE
PORT=9000

# 2. CHEMINS DE STOCKAGE (VOLUMES PERSISTANTS DANS LE CONTENEUR)
PEERFLIX_CONFIG_PATH=/data/config
PEERFLIX_DOWNLOAD_PATH=/data/downloads

# 3. SURVEILLANCE & LIMITES D'ESPACE DISQUE
MIN_FREE_DISK_MB=2048
# MAX_DISK_QUOTA_GB=200

# 4. ORDONNANCEUR DE NETTOYAGE AUTOMATIQUE (SCHEDULER)
AUTO_CLEAN_ENABLED=true
AUTO_CLEAN_DAY=1
AUTO_CLEAN_HOUR=9
AUTO_CLEAN_MINUTE=0

# 5. SÉCURITÉ, REVERSE PROXY & CORS
# PUBLIC_AUTH_CREDENTIALS=admin:monmotdepasse
# CORS_ORIGIN=https://peerflix.mon-domaine.com

# 6. INTÉGRATION C411 (RECHERCHE NATIVE & STREAMING 1-CLIC)
# C411_API_KEY=votre_cle_api_c411
# C411_BASE_URL=https://c411.org

# 7. SYSTÈME & DATE
TZ=Europe/Paris
NODE_ENV=production
